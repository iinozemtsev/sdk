import("../../utils/aot_snapshot.gni")
import("../../utils/application_snapshot.gni")

# All samples.
group("all") {
  deps = [
    ":aot",
    ":kernel",
  ]
}

group("aot") {
  deps = [
    ":run_main_aot",
    ":run_timer_aot",
    ":run_timer_async_aot",
    ":run_two_programs_aot",
  ]

  # FFI can't execute on the VM's simulator
  if (dart_target_arch == host_cpu) {
    deps += [ ":run_futures_aot" ]
  }
}

group("kernel") {
  deps = [
    ":run_main_kernel",
    ":run_timer_async_kernel",
    ":run_timer_kernel",
    ":run_two_programs_kernel",
  ]

  # FFI can't execute on the VM's simulator
  if (dart_target_arch == host_cpu) {
    deps += [ ":run_futures_kernel" ]
  }
}

_all_configs = [
  {
    suffix = "_kernel"
    dart_shared_lib = "../../runtime/engine:dart_engine_jit_shared"
    dart_snapshot_kind = "kernel"
    gen_kernel_args = [ "--link-platform" ]
    snapshot_target = "application_snapshot"
    training_args = []  # Not used
  },
  {
    suffix = "_aot"
    dart_shared_lib = "../../runtime/engine:dart_engine_aot_shared"
    snapshot_target = "aot_snapshot"

    # AOT snapshots as shared libraries on Windows are not
    # supported, and in fact we don't build AOT samples on
    # Windows. However, GN evaluation model will still
    # evaluate the `aot_snapshot` template on Windows,
    # and it will fail the assert if as_shared_library is
    # true, and the current platform is Windows.
    as_shared_library = !is_win
  },
]

template("shim_library") {
  configurable_deps = []
  if (defined(invoker.configurable_deps)) {
    configurable_deps += invoker.configurable_deps
  }
  extra_deps = []
  if (defined(invoker.extra_deps)) {
    extra_deps += invoker.extra_deps
  }
  foreach(conf, _all_configs) {
    target("shared_library", "${target_name}${conf.suffix}") {
      forward_variables_from(invoker,
                             "*",
                             [
                               "output_name",
                               "extra_deps",
                               "configurable_deps",
                             ])
      if (defined(invoker.output_name)) {
        output_name = "${invoker.output_name}${conf.suffix}"
      }
      if (!defined(include_dirs)) {
        include_dirs = []
      }
      include_dirs += [
        "../../runtime",
        "../../runtime/engine",
      ]
      if (!defined(ldflags)) {
        ldflags = []
      }
      if (is_mac) {
        ldflags += [ "-Wl,-install_name,@rpath/lib${output_name}.dylib" ]
      }
      deps = [ conf.dart_shared_lib ]
      foreach(dep, configurable_deps) {
        deps += [ "${dep}${conf.suffix}" ]
      }
      deps += extra_deps
    }
  }
}

template("sample") {
  configurable_deps = []
  if (defined(invoker.configurable_deps)) {
    configurable_deps += invoker.configurable_deps
  }
  extra_deps = []
  if (defined(invoker.extra_deps)) {
    extra_deps += invoker.extra_deps
  }
  foreach(conf, _all_configs) {
    target("executable", "${target_name}${conf.suffix}") {
      forward_variables_from(invoker,
                             "*",
                             [
                               "shim_deps",
                               "extra_deps",
                               "configurable_deps",
                             ])
      if (!defined(include_dirs)) {
        include_dirs = []
      }
      include_dirs += [
        "../../runtime",
        "../../runtime/engine",
      ]

      # Otherwise build with --no-clang (jit) or MSAN (aot) fails.
      if (is_linux) {
        if (!defined(ldflags)) {
          ldflags = []
        }
        ldflags += [ "-Wl,--allow-shlib-undefined" ]
      }
      deps = [ conf.dart_shared_lib ]
      foreach(dep, configurable_deps) {
        deps += [ "${dep}${conf.suffix}" ]
      }
      deps += extra_deps
    }
  }
}

template("snapshots") {
  configurable_deps = []
  if (defined(invoker.configurable_deps)) {
    configurable_deps += invoker.configurable_deps
  }
  extra_deps = []
  if (defined(invoker.extra_deps)) {
    extra_deps += invoker.extra_deps
  }
  foreach(conf, _all_configs) {
    target(conf.snapshot_target, "${target_name}${conf.suffix}") {
      forward_variables_from(invoker,
                             "*",
                             [
                               "extra_deps",
                               "configurable_deps",
                             ])
      if (defined(conf.dart_snapshot_kind)) {
        dart_snapshot_kind = conf.dart_snapshot_kind
      }
      if (defined(conf.training_args)) {
        training_args = conf.training_args
      }
      if (defined(conf.gen_kernel_args)) {
        gen_kernel_args = conf.gen_kernel_args
      }
      if (defined(conf.as_shared_library)) {
        as_shared_library = conf.as_shared_library
      }
      deps = []
      foreach(dep, configurable_deps) {
        deps += [ "${dep}${conf.suffix}" ]
      }
      deps += extra_deps
    }
  }
}

# Sample binary to run given kernel snapshot.
sample("run_main") {
  sources = [ "run_main.cc" ]
  configurable_deps = [ ":hello" ]
}

snapshots("hello") {
  main_dart = "hello.dart"
}

# Sample binary to run two snapshots simultaneously.
sample("run_two_programs") {
  sources = [ "run_two_programs.cc" ]
  configurable_deps = [
    ":program1",
    ":program2",
  ]
}

snapshots("program1") {
  main_dart = "program1.dart"
}

snapshots("program2") {
  main_dart = "program2.dart"
}

sample("run_timer") {
  include_dirs = [ "." ]
  sources = [ "run_timer.cc" ]
  configurable_deps = [
    ":timer",
    ":timer_library",
  ]
}

sample("run_timer_async") {
  include_dirs = [ "." ]
  sources = [ "run_timer_async.cc" ]
  configurable_deps = [
    ":timer",
    ":timer_library",
  ]
}

shim_library("timer_library") {
  output_name = "timer"
  public = [ "timer.h" ]
  sources = [
    "timer.cc",
    "timer.h",
  ]
}

snapshots("timer") {
  main_dart = "timer.dart"
}

# FFI can't execute on the VM's simulator
if (dart_target_arch == host_cpu) {
  snapshots("futures") {
    main_dart = "futures.dart"
  }

  sample("run_futures") {
    sources = [ "run_futures.cc" ]
    configurable_deps = [ ":futures" ]
  }
}
source_set("generated_for_timer_set") {
  sources = [
    "generated_for_timer.cc",
    "generated_for_timer.h",
  ]
  include_dirs = [
    "../../runtime",
    "../../runtime/engine",
  ]
}

shared_library("generated_for_timer") {
  deps = [ ":generated_for_timer_set" ]

  if (is_mac) {
    ldflags = [ "-Wl,-install_name,@rpath/libgenerated_for_timer.dylib" ]
  }

  if (is_ios) {
    ldflags = [
      "-undefined",
      "dynamic_lookup",
    ]
  }
}

executable("run_timer_shared_kernel") {
  include_dirs = [
    "../../runtime",
    "../../runtime/engine",
  ]
  sources = [ "run_timer_shared.cc" ]
  deps = [
    ":generated_for_timer",
    "../../runtime/engine:dart_engine_jit_shared",
  ]
  data_deps = [ ":timer_kernel" ]
}

template("dart_ios_framework") {
  assert(defined(invoker.shared_library), "Must have shared_library attribute")
  assert(defined(invoker.headers), "Must have headers attribute")
  assert(defined(invoker.framework_name), "Must have framework name")

  shared_library_name = get_label_info(invoker.shared_library, "name")
  dylib_name = "lib$shared_library_name.dylib"

  prebuilt_dart_action(target_name) {
    deps = [ invoker.shared_library ]

    # resources is a list of scopes, where each scope has src, dest,
    # and dep.
    resources_args = []
    if (defined(invoker.resources)) {
      foreach(resource, invoker.resources) {
        deps += [ resource.dep ]
        src = rebase_path("$root_out_dir/${resource.src}")
        resources_args += [ "--resources=$src:${resource.dst}" ]
      }
    }
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }
    script = "../../tools/create_framework.dart"
    headers = invoker.headers

    inputs = [
      "$root_out_dir/$dylib_name",
      "../../tools/create_framework.dart",
    ]
    framework_name = invoker.framework_name
    output = "$root_out_dir/$framework_name.framework"
    outputs = [ output ]

    args = [
      "--library=" + rebase_path("$root_out_dir/$dylib_name"),
      "--output=" + rebase_path(output),
      "--framework_name=$framework_name",
      "--create_umbrella_header",
    ]

    if (resources_args != []) {
      args += resources_args
    }

    inputs += headers
    foreach(header, headers) {
      args += [ "--headers=" + rebase_path(header) ]
    }
  }
}

dart_ios_framework("dart_timer_jit") {
  shared_library = ":generated_for_timer"
  headers = [ "generated_for_timer.h" ]
  framework_name = "DartTimer"
  resources = [
    {
      dep = ":timer_kernel"
      src = "gen/timer_kernel.dart.snapshot"
      dst = "assets/snapshot"
    },
  ]
}

dart_ios_framework("dart_timer_aot") {
  shared_library = ":generated_for_timer"
  headers = [ "generated_for_timer.h" ]
  framework_name = "DartTimerAot"
  resources = [
    {
      dep = ":timer_aot"
      src = "timer_aot.snapshot"
      dst = "assets/snapshot"
    },
  ]
}

